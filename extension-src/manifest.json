{
  "manifest_version": 3,
  "name": "Magic Garden Shop Alarm",
  "short_name": "Shop Alarm",
  "version": "1.0.0",
  "description": "Rings when the Magic Garden shop items you pick are in stock. Side panel with alarms, the shop, a crop calculator and the weather.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Shop Alarm", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "notifications", "tabs"],
  "host_permissions": ["https://magicgarden.gg/*"],
  "content_scripts": [
    { "matches": ["https://magicgarden.gg/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["https://magicgarden.gg/*"], "js": ["catalog.js", "content.js"], "run_at": "document_start", "all_frames": false }
  ]
}
